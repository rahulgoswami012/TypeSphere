{% extends 'admin/base_admin.html' %}
{% block title %}Benchmark Passages Management | TypeSphere Control Center{% endblock %}

{% block admin_content %}
<!-- Sector Header & Primary Actions -->
<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--admin-border); padding-bottom:0.75rem; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
  <div>
    <h1 style="font-size:1.6rem; font-weight:800; margin:0 0 0.25rem 0;">⚡ Benchmark Passages Manager</h1>
    <p style="color:var(--admin-text-muted); font-size:0.85rem; margin:0;">
      Manage passages served to pilots during primary speed benchmarks across all 9 public flight disciplines.
    </p>
  </div>
  <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
    <a href="{{ url_for('admin.benchmark_passage_create') }}" class="btn btn-sm btn-primary">+ Add Benchmark Text</a>
    <a href="{{ url_for('admin.benchmark_bulk_import') }}" class="btn btn-sm">📥 Bulk Import (CSV)</a>
    <a href="{{ url_for('admin.benchmark_sample_csv') }}" class="btn btn-sm">📄 Sample CSV</a>
  </div>
</div>

<!-- Compact Metric HUD -->
<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
  <div class="card" style="margin:0;">
    <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">TOTAL BENCHMARK TEXTS</div>
    <div style="font-size:1.75rem; font-weight:900; color:var(--admin-accent); margin-top:0.2rem;">{{ stats.total }}</div>
    <div style="font-size:0.75rem; color:var(--admin-text-muted);">Active in test rotation</div>
  </div>
  <div class="card" style="margin:0;">
    <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">WORDS & PASSAGES</div>
    <div style="font-size:1.75rem; font-weight:900; color:var(--admin-success); margin-top:0.2rem;">{{ stats.prose }}</div>
    <div style="font-size:0.75rem; color:var(--admin-text-muted);">Standard prose & literature</div>
  </div>
  <div class="card" style="margin:0;">
    <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">EXAM & MEMOS</div>
    <div style="font-size:1.75rem; font-weight:900; color:var(--admin-warning); margin-top:0.2rem;">{{ stats.exam }}</div>
    <div style="font-size:0.75rem; color:var(--admin-text-muted);">SSC & workplace memos</div>
  </div>
  <div class="card" style="margin:0;">
    <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">PROGRAMMING CODE</div>
    <div style="font-size:1.75rem; font-weight:900; color:#ec4899; margin-top:0.2rem;">{{ stats.code }}</div>
    <div style="font-size:0.75rem; color:var(--admin-text-muted);">Across 8 syntax engines</div>
  </div>
</div>

<!-- Public Discipline Filter Tabs -->
<div style="display:flex; gap:0.4rem; margin-bottom:1.25rem; flex-wrap:wrap; background:var(--admin-surface); padding:0.6rem; border-radius:8px; border:1px solid var(--admin-border);">
  <a href="{{ url_for('admin.benchmark_passages') }}" class="btn btn-sm {{ 'btn-primary' if not discipline_filter else '' }}">All ({{ stats.total }})</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='words') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'words' else '' }}">Words</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='paragraphs') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'paragraphs' else '' }}">Full Passages</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='exam') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'exam' else '' }}">SSC Exam</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='professional') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'professional' else '' }}">Workplace Memos</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='quotes') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'quotes' else '' }}">Quotes</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='code') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'code' else '' }}">Code</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='numbers') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'numbers' else '' }}">Numbers</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='punctuation') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'punctuation' else '' }}">Punctuation</a>
  <a href="{{ url_for('admin.benchmark_passages', discipline='data_entry') }}" class="btn btn-sm {{ 'btn-primary' if discipline_filter == 'data_entry' else '' }}">Data Entry</a>
</div>

<!-- Search & Quick Filters -->
<div class="card" style="padding:0.85rem; margin-bottom:1.25rem;">
  <form method="GET" action="{{ url_for('admin.benchmark_passages') }}" style="display:flex; gap:0.5rem; flex-wrap:wrap;">
    {% if discipline_filter %}<input type="hidden" name="discipline" value="{{ discipline_filter }}">{% endif %}
    <input type="text" name="q" value="{{ search or '' }}" placeholder="Search by title, passage text, or source..." style="flex:1; min-width:220px; padding:0.5rem 0.75rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:6px; color:#fff; font-size:0.85rem;">
    
    <select name="difficulty" style="padding:0.5rem 0.75rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:6px; color:#fff; font-size:0.85rem;">
      <option value="">All Tiers</option>
      <option value="easy" {% if difficulty_filter == 'easy' %}selected{% endif %}>Easy</option>
      <option value="moderate" {% if difficulty_filter == 'moderate' %}selected{% endif %}>Moderate</option>
      <option value="hard" {% if difficulty_filter == 'hard' %}selected{% endif %}>Hard</option>
      <option value="expert" {% if difficulty_filter == 'expert' %}selected{% endif %}>Expert</option>
    </select>

    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="{{ url_for('admin.benchmark_passages') }}" class="btn btn-sm">Reset</a>
  </form>
</div>

<!-- Lightweight Passages Table -->
<div class="card" style="padding:0; overflow:hidden;">
  <table>
    <thead>
      <tr>
        <th style="min-width:240px;">Passage Title & Content Preview</th>
        <th>Discipline</th>
        <th>Language / Syntax</th>
        <th>Difficulty</th>
        <th>Length</th>
        <th>Status</th>
        <th style="text-align:right;">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for p in passages.items %}
      <tr>
        <td>
          <div style="font-weight:700; color:var(--admin-text-main); font-size:0.92rem; margin-bottom:0.2rem;">
            {{ p.title }}
          </div>
          <div style="font-size:0.78rem; color:var(--admin-text-muted); font-family:var(--admin-mono); line-height:1.4; max-width:380px;">
            "{{ p.display_preview }}"
          </div>
        </td>
        <td>
          <span class="badge badge-primary" style="font-size:0.75rem;">
            {{ p.category|upper }}
          </span>
        </td>
        <td>
          {% if p.is_code %}
            <span class="badge badge-warning" style="font-size:0.72rem;">{{ (p.code_lang or 'Code')|upper }}</span>
          {% else %}
            <span style="font-size:0.78rem; color:var(--admin-text-muted);">English Prose</span>
          {% endif %}
        </td>
        <td>
          {% set diff = (p.difficulty or 'moderate')|lower %}
          <span class="badge {{ 'badge-success' if diff == 'easy' else ('badge-primary' if diff in ['moderate', 'medium'] else ('badge-warning' if diff == 'hard' else 'badge-danger')) }}">
            {{ diff|upper }}
          </span>
        </td>
        <td style="font-family:var(--admin-mono); font-size:0.82rem;">
          <strong>{{ p.word_count }}</strong> wds &bull; {{ p.character_count }} ch
        </td>
        <td>
          <span class="badge {{ 'badge-success' if p.is_active else 'badge-danger' }}">
            {{ 'ACTIVE' if p.is_active else 'INACTIVE' }}
          </span>
        </td>
        <td style="text-align:right;">
          <div style="display:inline-flex; gap:0.35rem;">
            <a href="{{ url_for('admin.benchmark_passage_edit', passage_id=p.id) }}" class="btn btn-sm">Edit</a>
            <form method="POST" action="{{ url_for('admin.benchmark_passage_delete', passage_id=p.id) }}" onsubmit="return confirm('Remove benchmark passage \'{{ p.title }}\'?');" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-danger">&times;</button>
            </form>
          </div>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="7" style="text-align:center; padding:2.5rem; color:var(--admin-text-muted);">
          No benchmark passages found for the selected criteria.
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<!-- Pagination -->
{% if passages.pages > 1 %}
<div style="display:flex; justify-content:space-between; align-items:center; margin-top:1.25rem;">
  <div style="font-size:0.8rem; color:var(--admin-text-muted);">
    Page {{ passages.page }} of {{ passages.pages }} ({{ passages.total }} total items)
  </div>
  <div style="display:flex; gap:0.35rem;">
    {% if passages.has_prev %}
    <a href="{{ url_for('admin.benchmark_passages', page=passages.prev_num, q=search, discipline=discipline_filter, difficulty=difficulty_filter) }}" class="btn btn-sm">&larr; Previous</a>
    {% endif %}
    {% if passages.has_next %}
    <a href="{{ url_for('admin.benchmark_passages', page=passages.next_num, q=search, discipline=discipline_filter, difficulty=difficulty_filter) }}" class="btn btn-sm">Next &rarr;</a>
    {% endif %}
  </div>
</div>
{% endif %}
{% endblock %}