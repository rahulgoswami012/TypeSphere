{% extends 'admin/base_admin.html' %}
{% block title %}Passage Library & Content CMS | TypeSphere Control Center{% endblock %}

{% block admin_content %}
<!-- Passage Section Sub-Navigation Tabs -->
<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--admin-border); padding-bottom:0.75rem; margin-bottom:1.25rem; flex-wrap:wrap; gap:0.75rem;">
  <div>
    <h1 style="font-size:1.6rem; font-weight:800; margin:0 0 0.25rem 0;">Passage Content Library</h1>
    <p style="color:var(--admin-text-muted); font-size:0.85rem; margin:0;">
      Aeronautical typing corpora, multi-level classification, duration rules, and content quality telemetry.
    </p>
  </div>
  <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
    <a href="{{ url_for('admin.passages_list') }}" class="btn btn-sm btn-primary">All Passages</a>
    <a href="{{ url_for('admin.passage_create') }}" class="btn btn-sm">+ Add Passage</a>
    <a href="{{ url_for('admin.export_csv', data_type='passages') }}" class="btn btn-sm">Export CSV</a>
  </div>
</div>

<!-- ============================================================
     1. PASSAGE LIBRARY OVERVIEW DASHBOARD
     ============================================================ -->
<div style="margin-bottom:1.5rem;">
  <!-- Row 1: Global Status Breakdown -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1rem;">
    <div class="card" style="margin:0;">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">TOTAL PASSAGES</div>
      <div style="font-size:1.85rem; font-weight:900; color:var(--admin-accent); margin-top:0.2rem;">{{ stats.total_passages }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">Active in platform database</div>
    </div>
    <div class="card" style="margin:0;">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">PUBLISHED</div>
      <div style="font-size:1.85rem; font-weight:900; color:var(--admin-success); margin-top:0.2rem;">{{ stats.published }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">Available in flight rotation</div>
    </div>
    <div class="card" style="margin:0;">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">DRAFT / IN REVIEW</div>
      <div style="font-size:1.85rem; font-weight:900; color:var(--admin-warning); margin-top:0.2rem;">{{ stats.draft + stats.review }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">{{ stats.draft }} drafts &bull; {{ stats.review }} pending review</div>
    </div>
    <div class="card" style="margin:0;">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">ARCHIVED</div>
      <div style="font-size:1.85rem; font-weight:900; color:var(--admin-danger); margin-top:0.2rem;">{{ stats.archived }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">Deprecated or removed</div>
    </div>
  </div>

  <!-- Row 2: Content Breakdown by Language & Type -->
  <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:1rem; margin-bottom:1.25rem;">
    <div class="card" style="margin:0; background:var(--admin-elevated);">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">ENGLISH CORPUS</div>
      <div style="font-size:1.5rem; font-weight:800; margin-top:0.2rem;">{{ stats.english_count }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">Standard & technical prose</div>
    </div>
    <div class="card" style="margin:0; background:var(--admin-elevated);">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">HINDI & REGIONAL</div>
      <div style="font-size:1.5rem; font-weight:800; color:var(--admin-accent); margin-top:0.2rem;">{{ stats.hindi_count + stats.regional_count }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">{{ stats.hindi_count }} Hindi &bull; {{ stats.regional_count }} Regional</div>
    </div>
    <div class="card" style="margin:0; background:var(--admin-elevated);">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">LITERATURE & QUOTES</div>
      <div style="font-size:1.5rem; font-weight:800; color:#ec4899; margin-top:0.2rem;">{{ stats.quotes_count }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">Short quotes & philosophy</div>
    </div>
    <div class="card" style="margin:0; background:var(--admin-elevated);">
      <div style="font-size:0.72rem; color:var(--admin-text-muted); font-weight:800; text-transform:uppercase;">EXAM PASSAGES</div>
      <div style="font-size:1.5rem; font-weight:800; color:var(--admin-warning); margin-top:0.2rem;">{{ stats.exam_count }}</div>
      <div style="font-size:0.75rem; color:var(--admin-text-muted);">SSC, CPCT, Court Steno packs</div>
    </div>
  </div>

  <!-- Quick Actions Bar -->
  <div class="card" style="padding:0.75rem 1.25rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; background:var(--admin-elevated);">
    <span style="font-size:0.8rem; font-weight:800; text-transform:uppercase; color:var(--admin-accent); letter-spacing:0.06em;">
      ⚡ Quick Management Actions:
    </span>
    <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
      <a href="{{ url_for('admin.passage_create') }}" class="btn btn-sm btn-primary">+ Add New Passage</a>
      <a href="{{ url_for('admin.export_csv', data_type='passages') }}" class="btn btn-sm">📥 Export All (CSV)</a>
      <a href="{{ url_for('admin.passages_list', status='draft') }}" class="btn btn-sm">📝 Review Drafts ({{ stats.draft }})</a>
      {% if stats.pending_reports > 0 %}
      <span class="badge badge-danger" style="display:inline-flex; align-items:center; padding:0.4rem 0.75rem;">
        🚨 {{ stats.pending_reports }} Reported Passages
      </span>
      {% endif %}
    </div>
  </div>
</div>

<!-- ============================================================
     2. SEARCH & MULTI-LEVEL FILTER MATRIX
     ============================================================ -->
<div class="card" style="padding:1.15rem; margin-bottom:1.25rem;">
  <form method="GET" action="{{ url_for('admin.passages_list') }}" style="display:flex; flex-direction:column; gap:0.75rem;">
    <div style="display:flex; gap:0.6rem; flex-wrap:wrap;">
      <input type="text" name="q" value="{{ search or '' }}" placeholder="Search passages by title, keyword, or excerpt..." style="flex:2; min-width:240px; padding:0.55rem 0.85rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:6px; color:#fff; font-size:0.88rem;">
      <button type="submit" class="btn btn-primary" style="padding:0.55rem 1.25rem; font-weight:800;">Filter Passages</button>
      <a href="{{ url_for('admin.passages_list') }}" class="btn" style="padding:0.55rem 1rem;">Reset Filters</a>
    </div>

    <!-- Dropdown Classification Filters -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px, 1fr)); gap:0.5rem;">
      <!-- Language -->
      <div>
        <label style="display:block; font-size:0.68rem; text-transform:uppercase; font-weight:800; color:var(--admin-text-muted); margin-bottom:0.25rem;">Language</label>
        <select name="language" style="width:100%; padding:0.45rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:4px; color:#fff; font-size:0.82rem;">
          <option value="">All Languages</option>
          <option value="english" {% if language_filter == 'english' %}selected{% endif %}>English</option>
          <option value="hindi" {% if language_filter == 'hindi' %}selected{% endif %}>Hindi</option>
          <option value="hinglish" {% if language_filter == 'hinglish' %}selected{% endif %}>Hinglish</option>
          <option value="regional" {% if language_filter == 'regional' %}selected{% endif %}>Regional Languages</option>
        </select>
      </div>

      <!-- Content Category -->
      <div>
        <label style="display:block; font-size:0.68rem; text-transform:uppercase; font-weight:800; color:var(--admin-text-muted); margin-bottom:0.25rem;">Category</label>
        <select name="category" style="width:100%; padding:0.45rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:4px; color:#fff; font-size:0.82rem;">
          <option value="">All Categories</option>
          {% for cat in categories %}
          <option value="{{ cat }}" {% if category_filter == cat %}selected{% endif %}>{{ cat }}</option>
          {% endfor %}
        </select>
      </div>

      <!-- Passage Type -->
      <div>
        <label style="display:block; font-size:0.68rem; text-transform:uppercase; font-weight:800; color:var(--admin-text-muted); margin-bottom:0.25rem;">Passage Type</label>
        <select name="passage_type" style="width:100%; padding:0.45rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:4px; color:#fff; font-size:0.82rem;">
          <option value="">All Types</option>
          {% for pt in passage_types %}
          <option value="{{ pt }}" {% if type_filter == pt %}selected{% endif %}>{{ pt|replace('_', ' ')|capitalize }}</option>
          {% endfor %}
        </select>
      </div>

      <!-- Difficulty -->
      <div>
        <label style="display:block; font-size:0.68rem; text-transform:uppercase; font-weight:800; color:var(--admin-text-muted); margin-bottom:0.25rem;">Difficulty</label>
        <select name="difficulty" style="width:100%; padding:0.45rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:4px; color:#fff; font-size:0.82rem;">
          <option value="">All Difficulties</option>
          <option value="easy" {% if difficulty_filter == 'easy' %}selected{% endif %}>Easy</option>
          <option value="moderate" {% if difficulty_filter == 'moderate' %}selected{% endif %}>Moderate</option>
          <option value="hard" {% if difficulty_filter == 'hard' %}selected{% endif %}>Hard</option>
          <option value="expert" {% if difficulty_filter == 'expert' %}selected{% endif %}>Expert</option>
        </select>
      </div>

      <!-- Publishing Status -->
      <div>
        <label style="display:block; font-size:0.68rem; text-transform:uppercase; font-weight:800; color:var(--admin-text-muted); margin-bottom:0.25rem;">Status</label>
        <select name="status" style="width:100%; padding:0.45rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:4px; color:#fff; font-size:0.82rem;">
          <option value="">All Statuses</option>
          <option value="published" {% if status_filter == 'published' %}selected{% endif %}>Published</option>
          <option value="draft" {% if status_filter == 'draft' %}selected{% endif %}>Draft</option>
          <option value="review" {% if status_filter == 'review' %}selected{% endif %}>Review Queue</option>
          <option value="archived" {% if status_filter == 'archived' %}selected{% endif %}>Archived</option>
        </select>
      </div>

      <!-- Exam Profile -->
      <div>
        <label style="display:block; font-size:0.68rem; text-transform:uppercase; font-weight:800; color:var(--admin-text-muted); margin-bottom:0.25rem;">Exam Profile</label>
        <select name="exam_profile" style="width:100%; padding:0.45rem; background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:4px; color:#fff; font-size:0.82rem;">
          <option value="">None / General</option>
          <option value="ssc_cgl" {% if exam_filter == 'ssc_cgl' %}selected{% endif %}>SSC CGL</option>
          <option value="ssc_chsl" {% if exam_filter == 'ssc_chsl' %}selected{% endif %}>SSC CHSL</option>
          <option value="rrb" {% if exam_filter == 'rrb' %}selected{% endif %}>RRB NTPC</option>
          <option value="cpct" {% if exam_filter == 'cpct' %}selected{% endif %}>CPCT</option>
          <option value="court_steno" {% if exam_filter == 'court_steno' %}selected{% endif %}>High Court Clerical</option>
        </select>
      </div>
    </div>
  </form>
</div>

<!-- ============================================================
     3. BULK ACTIONS CONTROLLER & 11-COLUMN DATA TABLE
     ============================================================ -->
<form method="POST" action="{{ url_for('admin.passages_bulk_action') }}" id="bulk-passages-form">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.65rem; padding:0 0.25rem; flex-wrap:wrap; gap:0.5rem;">
    <div style="font-size:0.82rem; color:var(--admin-text-muted);">
      <span id="selected-passages-count" style="font-weight:800; color:var(--admin-accent);">0</span> passage(s) selected
    </div>
    <div style="display:flex; gap:0.5rem; align-items:center;">
      <select name="action" id="bulk-action-select" style="padding:0.4rem 0.65rem; background:var(--admin-elevated); border:1px solid var(--admin-border); border-radius:4px; color:#fff; font-size:0.82rem;">
        <option value="" disabled selected>Choose Bulk Action...</option>
        <option value="publish">Mark as Published</option>
        <option value="unpublish">Move to Drafts</option>
        <option value="archive">Move to Archive</option>
        <option value="set_difficulty_easy">Set Difficulty: Easy</option>
        <option value="set_difficulty_moderate">Set Difficulty: Moderate</option>
        <option value="set_difficulty_hard">Set Difficulty: Hard</option>
        <option value="set_difficulty_expert">Set Difficulty: Expert</option>
        <option value="set_language_english">Set Language: English</option>
        <option value="set_language_hindi">Set Language: Hindi</option>
        <option value="delete">Permanently Delete</option>
      </select>
      <button type="submit" class="btn btn-sm btn-primary" onclick="return confirmBulkAction()">
        Apply Bulk Action
      </button>
    </div>
  </div>

  <div class="card" style="padding:0; overflow:hidden;">
    <table>
      <thead>
        <tr>
          <th style="width:36px; text-align:center;">
            <input type="checkbox" id="select-all-passages" onclick="toggleSelectAllPassages(this)">
          </th>
          <th style="min-width:240px;">Passage Title & Preview</th>
          <th>Language</th>
          <th>Category</th>
          <th>Type</th>
          <th>Difficulty</th>
          <th>Length</th>
          <th>Recommended</th>
          <th>Status</th>
          <th>Usage</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for p in passages.items %}
        {% set p_status = p.status or ('published' if p.is_active else 'archived') %}
        <tr>
          <!-- 1. Select -->
          <td style="text-align:center;">
            <input type="checkbox" name="selected_passage_ids" value="{{ p.id }}" class="passage-cb" onchange="updateSelectedPassagesCount()">
          </td>

          <!-- 2. Passage Title + Non-Clipped Excerpt -->
          <td>
            <div style="font-weight:700; color:var(--admin-text-main); font-size:0.92rem; margin-bottom:0.2rem;">
              {{ p.title }}
              {% if p.is_featured %}<span style="color:#f59e0b; font-size:0.75rem;" title="Featured Passage">★</span>{% endif %}
              {% if p.is_code %}<span class="badge badge-warning" style="font-size:0.65rem; padding:0.1rem 0.35rem;">CODE</span>{% endif %}
            </div>
            <div style="font-size:0.78rem; color:var(--admin-text-muted); font-family:var(--admin-mono); line-height:1.4; max-width:320px;">
              "{{ p.display_preview }}"
            </div>
            <div style="font-size:0.72rem; color:var(--admin-accent); margin-top:0.25rem;">
              {{ p.word_count }} words &bull; {{ p.character_count }} characters
            </div>
          </td>

          <!-- 3. Language -->
          <td>
            <span class="badge badge-primary" style="font-size:0.72rem;">
              {{ p.language|upper if p.language else 'ENGLISH' }}
            </span>
          </td>

          <!-- 4. Category -->
          <td>
            <strong style="font-size:0.85rem; color:var(--admin-text-main);">{{ p.category }}</strong>
          </td>

          <!-- 5. Type -->
          <td>
            <span style="font-size:0.78rem; background:var(--admin-elevated); padding:0.2rem 0.5rem; border-radius:4px; font-weight:600; text-transform:capitalize;">
              {{ p.passage_type or 'Paragraph' }}
            </span>
          </td>

          <!-- 6. Difficulty -->
          <td>
            {% set diff = (p.difficulty or 'moderate')|lower %}
            <span class="badge {{ 'badge-success' if diff == 'easy' else ('badge-primary' if diff == 'moderate' else ('badge-warning' if diff == 'hard' else 'badge-danger')) }}">
              {{ diff|upper }}
            </span>
          </td>

          <!-- 7. Words -->
          <td style="font-family:var(--admin-mono); font-size:0.84rem; font-weight:700;">
            {{ p.word_count }} <span style="font-size:0.72rem; color:var(--admin-text-muted);">wds</span>
          </td>

          <!-- 8. Recommended Time -->
          <td style="font-size:0.8rem; font-weight:700; color:var(--admin-accent);">
            {{ (p.recommended_duration // 60)|int if (p.recommended_duration and p.recommended_duration >= 60) else (p.recommended_duration or 60) }} min
          </td>

          <!-- 9. Status -->
          <td>
            {% if p_status == 'published' %}
              <span class="badge badge-success">PUBLISHED</span>
            {% elif p_status == 'draft' %}
              <span class="badge badge-warning">DRAFT</span>
            {% elif p_status == 'review' %}
              <span class="badge badge-primary">IN REVIEW</span>
            {% else %}
              <span class="badge badge-danger">ARCHIVED</span>
            {% endif %}
          </td>

          <!-- 10. Usage Tests -->
          <td style="font-family:var(--admin-mono); font-size:0.82rem; color:var(--admin-text-muted);">
            <strong>{{ p.times_used }}</strong> tests
          </td>

          <!-- 11. Actions -->
          <td style="text-align:right;">
            <div style="display:inline-flex; gap:0.3rem;">
              <button type="button" onclick="previewPassageModal({{ p.id }})" class="btn btn-sm" title="Quick Preview">👁️</button>
              <a href="{{ url_for('admin.passage_edit', passage_id=p.id) }}" class="btn btn-sm" title="Edit Passage">Edit</a>
              <form method="POST" action="{{ url_for('admin.passage_duplicate', passage_id=p.id) }}" style="display:inline;">
                <button type="submit" class="btn btn-sm" title="Clone to Draft">Clone</button>
              </form>
              <form method="POST" action="{{ url_for('admin.passage_delete', passage_id=p.id) }}" onsubmit="return confirm('Permanently remove this passage?');" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-danger" title="Delete">&times;</button>
              </form>
            </div>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="11" style="text-align:center; padding:3rem; color:var(--admin-text-muted);">
            No passages found matching the selected filter criteria. Click <strong>"Reset Filters"</strong> to view the entire library.
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</form>

<!-- Pagination Strip -->
{% if passages.pages > 1 %}
<div style="display:flex; justify-content:space-between; align-items:center; margin-top:1.25rem;">
  <div style="font-size:0.8rem; color:var(--admin-text-muted);">
    Page {{ passages.page }} of {{ passages.pages }} ({{ passages.total }} total passages)
  </div>
  <div style="display:flex; gap:0.35rem;">
    {% if passages.has_prev %}
    <a href="{{ url_for('admin.passages_list', page=passages.prev_num, q=search, language=language_filter, category=category_filter, passage_type=type_filter, difficulty=difficulty_filter, status=status_filter, exam_profile=exam_filter) }}" class="btn btn-sm">&larr; Previous</a>
    {% endif %}
    {% if passages.has_next %}
    <a href="{{ url_for('admin.passages_list', page=passages.next_num, q=search, language=language_filter, category=category_filter, passage_type=type_filter, difficulty=difficulty_filter, status=status_filter, exam_profile=exam_filter) }}" class="btn btn-sm">Next &rarr;</a>
    {% endif %}
  </div>
</div>
{% endif %}

<!-- ============================================================
     4. IN-PAGE PASSAGE PREVIEW MODAL
     ============================================================ -->
<div id="modal-passage-preview" class="cmd-overlay" onclick="if(event.target===this)closePreviewModal()">
  <div class="cmd-dialog" style="max-width:680px; padding:1.5rem; background:var(--admin-surface); border:1.5px solid var(--admin-accent);">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; border-bottom:1px solid var(--admin-border); padding-bottom:0.75rem;">
      <div>
        <span id="prev-lang-badge" class="badge badge-primary" style="margin-bottom:0.25rem;">ENGLISH</span>
        <h2 id="prev-title" style="font-size:1.35rem; font-weight:800; color:#fff; margin:0;">Passage Preview</h2>
        <span id="prev-meta" style="font-size:0.8rem; color:var(--admin-text-muted);">Technology &bull; Moderate &bull; Paragraph</span>
      </div>
      <button type="button" onclick="closePreviewModal()" class="btn btn-sm">&times;</button>
    </div>

    <!-- Metrics Row -->
    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:0.75rem; background:var(--admin-elevated); padding:0.75rem; border-radius:6px; margin-bottom:1rem; text-align:center;">
      <div><span style="font-size:0.68rem; color:var(--admin-text-muted); text-transform:uppercase;">Words</span><div id="prev-words" style="font-size:1.15rem; font-weight:800; color:var(--admin-accent);">0</div></div>
      <div><span style="font-size:0.68rem; color:var(--admin-text-muted); text-transform:uppercase;">Characters</span><div id="prev-chars" style="font-size:1.15rem; font-weight:800;">0</div></div>
      <div><span style="font-size:0.68rem; color:var(--admin-text-muted); text-transform:uppercase;">Avg Word</span><div id="prev-avg" style="font-size:1.15rem; font-weight:800;">0.0</div></div>
      <div><span style="font-size:0.68rem; color:var(--admin-text-muted); text-transform:uppercase;">Health</span><div id="prev-health" style="font-size:1.15rem; font-weight:800; color:var(--admin-success);">100%</div></div>
    </div>

    <!-- Complete Passage Content -->
    <div style="background:var(--admin-bg); border:1px solid var(--admin-border); border-radius:6px; padding:1.25rem; font-family:var(--admin-mono); font-size:0.95rem; line-height:1.75; color:#f1f5f9; max-height:260px; overflow-y:auto; margin-bottom:1.25rem; white-space:pre-wrap;" id="prev-body">
      Passage text loading...
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center;">
      <a id="prev-edit-btn" href="#" class="btn btn-primary btn-sm">Edit Passage in Full Studio &rarr;</a>
      <button type="button" onclick="closePreviewModal()" class="btn btn-sm">Close Preview</button>
    </div>
  </div>
</div>

<script>
function toggleSelectAllPassages(master) {
  document.querySelectorAll('.passage-cb').forEach(cb => cb.checked = master.checked);
  updateSelectedPassagesCount();
}

function updateSelectedPassagesCount() {
  const count = document.querySelectorAll('.passage-cb:checked').length;
  document.getElementById('selected-passages-count').textContent = count;
}

function confirmBulkAction() {
  const select = document.getElementById('bulk-action-select');
  const action = select.value;
  const count = document.querySelectorAll('.passage-cb:checked').length;

  if (!action) {
    alert("Please select a bulk action from the dropdown.");
    return false;
  }
  if (count === 0) {
    alert("Please select at least one passage using the checkboxes.");
    return false;
  }
  if (action === 'delete') {
    return confirm(`Are you sure you want to permanently delete ${count} selected passage(s)? This cannot be undone.`);
  }
  return confirm(`Execute bulk action '${action}' across ${count} selected passage(s)?`);
}

function previewPassageModal(passageId) {
  fetch(`/admin/passages/api/preview/${passageId}`)
    .then(res => res.json())
    .then(data => {
      document.getElementById('prev-title').textContent = data.title;
      document.getElementById('prev-lang-badge').textContent = (data.language || 'ENGLISH').toUpperCase();
      document.getElementById('prev-meta').textContent = `${data.category} • ${data.difficulty.toUpperCase()} • ${data.passage_type.toUpperCase()}`;
      document.getElementById('prev-words').textContent = data.word_count;
      document.getElementById('prev-chars').textContent = data.character_count;
      document.getElementById('prev-avg').textContent = `${data.avg_word_length} ch`;
      document.getElementById('prev-health').textContent = `${data.health_score}%`;
      document.getElementById('prev-body').textContent = data.content;
      document.getElementById('prev-edit-btn').href = `/admin/passages/${data.id}/edit`;
      document.getElementById('modal-passage-preview').style.display = 'flex';
    })
    .catch(() => alert('Could not load passage preview.'));
}

function closePreviewModal() {
  document.getElementById('modal-passage-preview').style.display = 'none';
}
</script>
